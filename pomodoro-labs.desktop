[Desktop Entry]
Name=Pomodoro Labs
Comment=Timer Pomodoro kecil yang selalu di atas jendela lain
Exec=@BIN@
Icon=alarm-symbolic
Terminal=false
Type=Application
Categories=Utility;
Actions=Pomodoro;Manual;

[Desktop Action Pomodoro]
Name=Pomodoro manual
Exec=@BIN@ --pomodoro

[Desktop Action Manual]
Name=Timer manual
Exec=@BIN@ --manual
